{
  "name": "outpost-zero",
  "private": true,
  "version": "1.0.0",
  "description": "Tactical 3D First-Person Shooter Combat Simulator",
  "author": "Outpost Zero Team",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "windows:native": "windows\\OutpostZero.Native\\build-native.cmd",
    "windows:native-test": "windows\\OutpostZero.Native\\bin\\x64\\Release\\OutpostZero.Native.Tests.exe",
    "windows:build": "npm run build && windows\\OutpostZero.Native\\build-native.cmd && dotnet build windows\\OutpostZero.WinUI\\OutpostZero.WinUI.csproj -c Release -p:Platform=x64 --source \"%USERPROFILE%\\.nuget\\packages\" --source \"C:\\Program Files (x86)\\Microsoft SDKs\\NuGetPackages\"",
    "windows:run": "windows\\OutpostZero.WinUI\\bin\\x64\\Release\\net10.0-windows10.0.22621.0\\win-x64\\OutpostZero.exe",
    "electron:dev": "cross-env ELECTRON_DEV_URL=http://localhost:3000 electron .",
    "electron:app": "electron .",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:build": "npm run build && electron-builder --win",
    "clean": "rm -rf dist server.js release windows\\OutpostZero.WinUI\\bin windows\\OutpostZero.WinUI\\obj windows\\OutpostZero.Native\\bin",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "peerjs": "^1.5.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wait-on": "^9.5.1"
  }
}
