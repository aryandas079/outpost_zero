<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OutpostZero.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="OUTPOST ZERO — 10 km² Battle Royale &amp; Tactical FPS">

    <Grid Background="#090D13">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Dark Title Bar & Native Hardware Diagnostics Strip (Toggle F9) -->
        <Grid
            x:Name="NativeTopBar"
            Grid.Row="0"
            Height="34"
            Background="#10161D"
            BorderBrush="#24303D"
            BorderThickness="0,0,0,1"
            Padding="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock
                    Text="OUTPOST ZERO"
                    Foreground="#F2F4F5"
                    FontSize="11"
                    FontWeight="Bold"
                    CharacterSpacing="120"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="GpuStatusText"
                    Text="D3D/WebGL2"
                    Foreground="#52C7DE"
                    FontFamily="Consolas"
                    FontSize="11"
                    VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel
                x:Name="DiagnosticsStrip"
                Grid.Column="1"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="DiagnosticsDetailText"
                    Text="C++ Native Telemetry Ready"
                    Foreground="#A8B0B8"
                    FontFamily="Consolas"
                    FontSize="11" />
                <Button
                    Content="Reload"
                    Click="OnReloadClick"
                    Padding="8,2"
                    FontSize="11"
                    Background="#18222C"
                    Foreground="#F2F4F5" />
                <Button
                    Content="F11 Fullscreen"
                    Click="OnFullscreenClick"
                    Padding="8,2"
                    FontSize="11"
                    Background="#18222C"
                    Foreground="#52C7DE" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button
                    Content="F9 Stats"
                    Click="OnToggleStatsClick"
                    Padding="8,2"
                    FontSize="10"
                    Background="#141C24"
                    Foreground="#A8B0B8" />
                <Button
                    Content="F11"
                    Click="OnFullscreenClick"
                    Padding="8,2"
                    FontSize="10"
                    Background="#141C24"
                    Foreground="#52C7DE" />
            </StackPanel>
        </Grid>

        <!-- Game Viewport (WebView2 Hardware WebGL2 + Bidirectional Bridge) -->
        <controls:WebView2
            x:Name="GameWebView"
            Grid.Row="1"
            DefaultBackgroundColor="#090D13" />

        <!-- Graceful Renderer Crash Recovery Overlay -->
        <Grid
            x:Name="RecoveryOverlay"
            Grid.Row="1"
            Background="#E6090D13"
            Visibility="Collapsed">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="14"
                MaxWidth="420"
                Padding="28"
                Background="#10161D"
                BorderBrush="#E05252"
                BorderThickness="1">
                <TextBlock
                    Text="RENDERER PROCESS INTERRUPTED"
                    Foreground="#E05252"
                    FontSize="14"
                    FontWeight="Bold"
                    CharacterSpacing="100" />
                <TextBlock
                    Text="The WebGL2 rendering host encountered a GPU reset or unexpected shutdown. Click below to restore the active host session cleanly."
                    TextWrapping="Wrap"
                    Foreground="#A8B0B8"
                    FontSize="12" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button
                        Content="RECOVER GAME ENGINE"
                        Click="OnReloadClick"
                        Background="#52C7DE"
                        Foreground="#10161D"
                        FontWeight="Bold"
                        Padding="14,6" />
                    <Button
                        Content="EXIT"
                        Click="OnExitClick"
                        Background="#1C242E"
                        Foreground="#F2F4F5"
                        Padding="14,6" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
